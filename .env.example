# REQUIRED — main backend API (login lives here). Include /api, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://arfq-api.potatobazaar.com/api

# OPTIONAL (local dev) — Super Admin platform service when not behind a reverse proxy.
# Production usually omits this and nginx routes /api/platform/* to platform-be.
# NEXT_PUBLIC_PLATFORM_API_BASE_URL=http://localhost:4005/api

# OPTIONAL — only if the super admin uploads files (e.g. company logo).
# If omitted, it falls back to NEXT_PUBLIC_API_BASE_URL. Usually leave unset.
# NEXT_PUBLIC_S3_UPLOAD_HOST=https://arfq-api.potatobazaar.com/api
